{
  "name": "weather-globe",
  "version": "0.1.0",
  "description": "A spinnable WebGL globe with live satellite infrared clouds, day and night, zoom-in detail tiles and city temperatures. Hand-written WebGL2, no 3D library.",
  "author": "Joseph Salhi",
  "license": "MIT",
  "private": true,
  "type": "module",
  "keywords": ["webgl", "globe", "weather", "satellite", "infrared", "react", "vite"],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "music": "node scripts/resolve-music.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
